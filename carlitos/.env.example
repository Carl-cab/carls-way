# Carlitos dashboard — environment
#
# The dashboard ships with mock data and needs no env vars to run. When you point
# it at a live OpenJarvis runtime (see src/lib/mock.ts), set the local endpoint
# here and read it via import.meta.env in your fetch/WebSocket calls.

# Base URL of your local OpenJarvis API/server (jarvis serve).
VITE_JARVIS_API_URL=http://127.0.0.1:8787
